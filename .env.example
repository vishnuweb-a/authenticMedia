# ---------------------------------------------------------------------------
# Frontend — shipped to browsers
# ---------------------------------------------------------------------------
#
# Both of these are designed to be public; Row Level Security is what actually
# protects the data. NEVER put SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable —
# it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server only — NEVER prefixed, NEVER committed
# ---------------------------------------------------------------------------
#
# Everything below is read by the serverless functions in api/ and by nothing
# else. This is a Vite app, so any VITE_ / NEXT_PUBLIC_ / REACT_APP_ prefix
# would compile the value into the browser bundle (AIPAY-DOCS §2.3).
#
# Set these in the Vercel project's Environment Variables, not in a file that
# reaches source control.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Airpay (AIPAY-DOCS §2.1)
AIRPAY_MID=
AIRPAY_CLIENT_ID=

# ⚠ PROVEN (§2.2) — these two are SWAPPED relative to what Airpay's own
# onboarding states, and each is used in exactly one role:
#   AIRPAY_SECRET_KEY = the OAuth2 client_secret
#   AIRPAY_API_KEY    = the secret in the privatekey derivation
# Swapping them back yields "Invalid client id or secret" and
# "Merchant Key Authentication Failed" respectively.
AIRPAY_SECRET_KEY=
AIRPAY_API_KEY=

AIRPAY_USERNAME=
AIRPAY_PASSWORD=

# ---------------------------------------------------------------------------
# Airpay merchant 2 (AIPAY-DOCS §2.4)
# ---------------------------------------------------------------------------
#
# The SECOND merchant account. Identical roles to the unsuffixed set above,
# including the ⚠ PROVEN SECRET_KEY / API_KEY swap — read that note again
# before filling these in.
#
# REQUIRED. Both merchants are offered side by side at checkout, so a shopper
# can select this one at any time — and these variables must also stay present
# while any merchant-2 order is unsettled, because settlement resolves the
# merchant from the order reference and an AM2- order asks for them long after
# it was created.
#
# Missing here means merchant 2 fails closed: a shopper who picks Option 2 gets
# `payments_unavailable`, and no order is signed with the wrong credentials.
AIRPAY_MID_2=
AIRPAY_CLIENT_ID_2=
AIRPAY_SECRET_KEY_2=
AIRPAY_API_KEY_2=
AIRPAY_USERNAME_2=
AIRPAY_PASSWORD_2=

# There is deliberately NO merchant switch variable.
#
# Which merchant takes a NEW order is the shopper's choice at checkout: the
# browser sends an index (1 or 2) that the server validates against an
# exhaustive allowlist and maps onto one of the two credential sets above. The
# browser never sees, sends or names a MID, a credential or a configuration.
#
# Orders already created keep settling against the merchant that created them,
# because the merchant is encoded in the order reference (AM- vs AM2-) and is
# read back from there — never from the environment and never from a request.
#
# AIRPAY_ACTIVE_MERCHANT is GONE. Nothing reads it; setting it does nothing.

# Explicit, never inferred. Order Confirmation works only against a live MID;
# on sandbox an order is left unsettled rather than trusted (§10.3).
AIRPAY_ENV=live

# Optional Order Confirmation override. Leave UNSET, not blank: a
# defined-but-empty value fails URL validation and takes all payments down
# (edge case 43). The default is .../api/verify/ — never /orderconfirmation/,
# which 404s and strands every order (edge case 6).
# AIRPAY_VERIFY_URL=

# Bearer token for GET|POST /api/payments/reconcile. Required: the endpoint
# drives outbound calls against the live MID (§16). Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# KKChat relay (AIPAY-DOCS §13)
# ---------------------------------------------------------------------------
#
# Airpay's Response and IPN URLs both point at this application:
#   https://authenticmedia.fun/callback/cpm/arp_frontiva/collection
# which then forwards the opened callback fields to KKChat.
#
# Optional. Unset uses the client-confirmed default:
#   https://kkchat.in/callback/cpm/arp_frontiva/collection
# Set to `off` to disable relaying entirely.
#
# ⚠ PROVEN (§13.2) — the middle path segment IS the whole integration. KKChat
# routes only on the trailing /collection and answers 200 "success" to ANY
# middle segment, discarding what it does not recognise. `arp_frontiva` is the
# real one; a 200 from this host is NOT evidence of delivery.
# KKCHAT_CALLBACK_URL=
#
# ⚠ This relay applies to MERCHANT 1 ONLY (§2.4, §13.8). Merchant 2 registers
#   https://kkchat.in/callback/cpm/arp/collection
# as its own Response and IPN URL, so Airpay delivers there DIRECTLY and this
# application is not in that path. Nothing here forwards a merchant-2 callback;
# doing so would be a duplicate delivery, not a missing one. Note the middle
# segment differs (`arp`, not `arp_frontiva`) — the two must never be
# normalised into each other.
#
# ⚠ Because Airpay sends merchant 2's browser RESPONSE to that same KKChat URL,
# Airpay never navigates the shopper back here. The browser return for merchant
# 2 is arranged on our side instead: the hosted page opens in a separate window
# and the original tab polls /api/orders/status, then moves the shopper to
# /order-success itself (AIPAY-DOCS §14.3). No Airpay dashboard URL changes, and
# no environment variable configures this — it follows from the merchant.

# Absolute origin for the post-payment redirect (§14.2). Authoritative when
# set; otherwise the redirect is built from the forwarded host of this same
# deployment.
# PUBLIC_SITE_ORIGIN=https://authenticmedia.fun
