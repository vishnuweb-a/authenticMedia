# Supabase — frontend-safe values only.
#
# Both of these are designed to be shipped to browsers; Row Level Security is
# what actually protects the data. NEVER put SUPABASE_SERVICE_ROLE_KEY in this
# file or anywhere else in the frontend — it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Airpay is NOT integrated. When it is, the merchant ID, secret and callback
# signing key belong to a trusted backend — never to this file.
