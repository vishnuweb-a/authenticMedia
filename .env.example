# ---------------------------------------------------------------------------
# Frontend — shipped to browsers
# ---------------------------------------------------------------------------
#
# Both of these are designed to be public; Row Level Security is what actually
# protects the data. NEVER put SUPABASE_SERVICE_ROLE_KEY in a VITE_ variable —
# it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ---------------------------------------------------------------------------
# Server only — NEVER prefixed, NEVER committed
# ---------------------------------------------------------------------------
#
# Everything below is read by the serverless functions in api/ and by nothing
# else. This is a Vite app, so any VITE_ / NEXT_PUBLIC_ / REACT_APP_ prefix
# would compile the value into the browser bundle (AIPAY-DOCS §2.3).
#
# Set these in the Vercel project's Environment Variables, not in a file that
# reaches source control.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Airpay (AIPAY-DOCS §2.1)
AIRPAY_MID=
AIRPAY_CLIENT_ID=

# ⚠ PROVEN (§2.2) — these two are SWAPPED relative to what Airpay's own
# onboarding states, and each is used in exactly one role:
#   AIRPAY_SECRET_KEY = the OAuth2 client_secret
#   AIRPAY_API_KEY    = the secret in the privatekey derivation
# Swapping them back yields "Invalid client id or secret" and
# "Merchant Key Authentication Failed" respectively.
AIRPAY_SECRET_KEY=
AIRPAY_API_KEY=

AIRPAY_USERNAME=
AIRPAY_PASSWORD=

# ---------------------------------------------------------------------------
# Airpay merchant 2 (AIPAY-DOCS §2.4)
# ---------------------------------------------------------------------------
#
# The SECOND merchant, MID 362380. Same six variables, same roles, `_2`
# suffix — including the same PROVEN secret swap described above.
#
# The shopper chooses between merchant 1 and merchant 2 at checkout. The
# browser sends only an INDEX (1 or 2); it never sees, sends or names a MID, a
# credential or a URL, and the server maps that index onto one of these two
# credential sets itself.
#
# ⚠ There is deliberately NO AIRPAY_ACTIVE_MERCHANT and no other merchant
# switch. A global environment variable choosing the merchant would silently
# override the customer's own choice, which is exactly what this design
# prevents. Nothing reads such a variable; setting one does nothing.
#
# ⚠ AIRPAY_ENV is NOT suffixed. One deployment cannot be live for one merchant
# and sandbox for the other.
AIRPAY_MID_2=
AIRPAY_CLIENT_ID_2=
AIRPAY_SECRET_KEY_2=
AIRPAY_API_KEY_2=
AIRPAY_USERNAME_2=
AIRPAY_PASSWORD_2=

# Explicit, never inferred. Order Confirmation works only against a live MID;
# on sandbox an order is left unsettled rather than trusted (§10.3).
AIRPAY_ENV=live

# Optional Order Confirmation override. Leave UNSET, not blank: a
# defined-but-empty value fails URL validation and takes all payments down
# (edge case 43). The default is .../api/verify/ — never /orderconfirmation/,
# which 404s and strands every order (edge case 6).
# AIRPAY_VERIFY_URL=

# Bearer token for GET|POST /api/payments/reconcile. Required: the endpoint
# drives outbound calls against the live MID (§16). Vercel Cron sends this
# automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# KKChat relay (AIPAY-DOCS §13)
# ---------------------------------------------------------------------------
#
# Airpay's Response and IPN URLs both point at this application:
#   https://authenticmedia.fun/callback/cpm/arp_frontiva/collection
# which then forwards the opened callback fields to KKChat.
#
# Optional. Unset uses the client-confirmed default:
#   https://kkchat.in/callback/cpm/arp_frontiva/collection
# Set to `off` to disable relaying entirely.
#
# ⚠ PROVEN (§13.2) — the middle path segment IS the whole integration. KKChat
# routes only on the trailing /collection and answers 200 "success" to ANY
# middle segment, discarding what it does not recognise. `arp_frontiva` is the
# real one; a 200 from this host is NOT evidence of delivery.
# KKCHAT_CALLBACK_URL=
#
# ⚠ This destination is MERCHANT 1's, and is unchanged.
#
# Merchant 2's callbacks are NOT relayed from here. Airpay delivers them
# directly to the URL configured in that merchant's own Airpay dashboard, so
# this application is not in that path at all — a relay of ours would be a
# SECOND delivery of a callback KKChat already has, not a missing one.

# Absolute origin for the post-payment redirect (§14.2). Authoritative when
# set; otherwise the redirect is built from the forwarded host of this same
# deployment.
# PUBLIC_SITE_ORIGIN=https://authenticmedia.fun
