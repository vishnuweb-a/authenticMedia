{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/orders/:ref", "destination": "/api/orders/status?ref=:ref" },
    {
      "source": "/callback/cpm/arp_frontiva/collection",
      "destination": "/api/callback/cpm/arp_frontiva/collection"
    },
    {
      "source": "/callback/cpm/arp_frontiva/collection/",
      "destination": "/api/callback/cpm/arp_frontiva/collection"
    },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/orders/status.ts": { "maxDuration": 10 },
    "api/payments/create.ts": { "maxDuration": 10 },
    "api/payments/reconcile.ts": { "maxDuration": 10 },
    "api/callback/cpm/arp_frontiva/collection.ts": { "maxDuration": 10 }
  },
  "crons": [
    {
      "path": "/api/payments/reconcile",
      "schedule": "0 3 * * *"
    }
  ]
}
